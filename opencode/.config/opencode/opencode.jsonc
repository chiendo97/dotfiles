{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": ["opencode"],
  "agent": {
    "build": {
      "model": "zariel/vllm-model"
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "variant": "xhigh"
    }
  },
  "permission": "allow",
  "provider": {
    "zariel": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Zariel Bifrost",
      "env": ["OPENAI_API_KEY"],
      "options": {
        "baseURL": "{env:OPENAI_BASE_URL}"
      },
      "models": {
        "vllm-model": {
          "id": "vllm/vllm-model",
          "name": "vLLM Model",
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "xhigh": {}
          }
        }
      }
    }
  }
}
