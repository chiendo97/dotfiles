{
  "$schema": "https://opencode.ai/tui.json",
  "keybinds": {
    "command_list": "ctrl+o",
    "messages_page_up": "pageup,ctrl+u",
    "messages_page_down": "pagedown,ctrl+d",
    "input_delete": "delete,shift+delete",
    "input_delete_to_line_start": "none",
    "history_previous": "up,ctrl+p",
    "history_next": "down,ctrl+n",
    "editor_open": "<leader>e,ctrl+g",
    "which_key_toggle": "ctrl+alt+k,f1",
    "app_exit": "ctrl+c,<leader>q"
  }
}